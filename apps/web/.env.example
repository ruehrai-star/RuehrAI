# Backend base URL. The API listens on 3000; this app uses 3001.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000

# STAGE public edge http://217.160.164.239: same origin, not a mesh address.
# The browser calls nginx on Ubuntu, which proxies /api/ to Nest on Eule.
# Empty is also relative (site root). Never put a Tailscale IP in NEXT_PUBLIC_*.
# NEXT_PUBLIC_API_BASE_URL=/api
