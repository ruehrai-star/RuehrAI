# Local Postgres from docker-compose.yml (Brain / schema app).
# These values are development defaults, not production secrets.
DATABASE_URL=postgres://ruehrai:ruehrai@localhost:5432/ruehrai

# Data-Scout on Eule (read-only geo_ref_address / geo_ref_plz). Not Brain, not Supabase.
# Nest on Eule uses localhost:5432, database Data-Scout, user ruehrai.
# Password matches Brain. Do not commit a real password.
# Leave unset in local/CI: store pins then use the PLZ stub in app.search_places.
# DATASCOUT_DATABASE_URL=postgres://ruehrai:ruehrai@localhost:5432/Data-Scout

# Required to sign JWTs. Replace this placeholder outside a private local machine.
JWT_SECRET=change-me-local-dev-only

# HTTP port. OpenAPI local server URL is http://localhost:3000.
PORT=3000

# Embeddings / LLM base URL (CTO correction 2026-09-29).
# STAGE runs on Eule (168.192.2.194) and uses local oMLX.
# Fuchs (168.192.2.123) remains PROD / remote oMLX.
# Do not use OpenAI. Clients never call this host; only this backend does,
# and only for Musteranalyse and Empfehlungs-Begründungen (query embeddings and optional chat).
# GET /search stays SQL against features.v_location_search.
# Leave the URLs unset (or set ANALYSIS_VECTOR_SEARCH=0) when oMLX is down:
# analysis then uses the SQL region filter and a heuristic pattern.
#
# STAGE (Eule):
# EMBEDDINGS_BASE_URL=http://localhost:8000/v1
# PROD / remote Fuchs (localhost if the process runs on Fuchs):
# EMBEDDINGS_BASE_URL=http://168.192.2.123:8000/v1
# EMBEDDING_MODEL=rg113/jina-embeddings-v5-text-small-retrieval-mlx-oQ8
# EMBEDDING_DIM=1024
# LLM_BASE_URL defaults to EMBEDDINGS_BASE_URL. Set it only for a different host.
# LLM_BASE_URL=http://localhost:8000/v1
# LLM_MODEL is required for pattern.source=llm. Unset keeps source=heuristic.
# LLM_MODEL=
# ANALYSIS_VECTOR_SEARCH=0
#
# OMLX_API_KEY authenticates this backend to oMLX.
# On STAGE (Eule), copy auth.api_key from ~/.omlx/settings.json into this variable.
# Never commit the real value. Clients never call oMLX.
# Unset: the process still starts and calls go out without an Authorization header.
# If oMLX requires a key it returns HTTP 401, and analysis / recommendations stay
# on the SQL and heuristic path. Query embeddings and source=llm need this key.
# OMLX_API_KEY=
