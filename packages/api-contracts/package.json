{
  "name": "@ruehrai/api-contracts",
  "version": "0.1.0",
  "private": true,
  "description": "OpenAPI v0 contract for the RuehrAI backend",
  "license": "UNLICENSED",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./openapi.yaml": "./openapi/openapi.yaml",
    "./openapi.json": "./openapi/openapi.json"
  },
  "files": [
    "dist",
    "openapi",
    "src"
  ],
  "scripts": {
    "generate": "node scripts/build-json.mjs && openapi-typescript openapi/openapi.yaml -o src/generated.ts",
    "build": "pnpm generate && tsc -p tsconfig.json",
    "test": "node --test test/contract.test.mjs"
  },
  "devDependencies": {
    "openapi-typescript": "^7.9.1",
    "typescript": "^5.9.2",
    "yaml": "^2.8.1"
  }
}
