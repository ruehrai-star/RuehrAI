{
  "openapi": "3.0.3",
  "info": {
    "title": "RuehrAI API",
    "version": "0.2.0",
    "description": "Dev-Team slice (v0). The backend issues its own JWTs and reads a local\nPostgres database via `DATABASE_URL`. Clients call this API; they do not\ntalk to the database.\n\nBase URL is environment-driven. Local default is `http://localhost:3000`\n(`PORT`, default 3000). Deployed clients should take the base URL from\ntheir own configuration and use this document as the contract.\n\nLocal migrations seed a development user `dev@ruehrai.local` /\n`dev-password`. That account is a fixture for local runs, not a production\ncredential. `POST /auth/register` creates further users in `app.users`.\n`POST /auth/logout` revokes that access token until it expires.\n\nCustomer inputs (target region, store addresses, monthly revenue) are\nstored in schema `app` and are visible only to the user id in the token.\n"
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Local development. The host and port follow the backend `PORT` env (default 3000)."
    }
  ],
  "tags": [
    {
      "name": "Health"
    },
    {
      "name": "Auth"
    },
    {
      "name": "Search"
    },
    {
      "name": "Layers"
    },
    {
      "name": "TargetRegion"
    },
    {
      "name": "Stores"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "Health"
        ],
        "operationId": "getHealth",
        "summary": "Liveness",
        "description": "Process is up. This check does not query Postgres.",
        "security": [],
        "responses": {
          "200": {
            "description": "Process is alive.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                },
                "example": {
                  "status": "ok"
                }
              }
            }
          }
        }
      }
    },
    "/auth/login": {
      "post": {
        "tags": [
          "Auth"
        ],
        "operationId": "login",
        "summary": "Exchange email and password for a JWT",
        "description": "Returns a bearer token. Local databases seeded by `db/migrations`\ninclude `dev@ruehrai.local` / `dev-password`.\n",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Credentials"
              },
              "example": {
                "email": "dev@ruehrai.local",
                "password": "dev-password"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Authenticated.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "description": "Unknown email or wrong password.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/auth/register": {
      "post": {
        "tags": [
          "Auth"
        ],
        "operationId": "register",
        "summary": "Create a user and return a JWT",
        "description": "Password hashing is done in Postgres (`pgcrypto` bcrypt) and the row is\nstored in `app.users`. Minimum password length is 8. The response matches\n`POST /auth/login`.\n",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Credentials"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "User created and signed in.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "409": {
            "description": "Email is already registered.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/auth/me": {
      "get": {
        "tags": [
          "Auth"
        ],
        "operationId": "getCurrentUser",
        "summary": "Current user",
        "description": "Requires Authorization: Bearer <accessToken>.",
        "responses": {
          "200": {
            "description": "User row for the token subject.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "tags": [
          "Auth"
        ],
        "operationId": "logout",
        "summary": "Revoke the current access token",
        "description": "Requires `Authorization: Bearer <accessToken>`. Stores the token id\n(`jti`) in `app.revoked_tokens` until the token's own expiry. A later\nrequest with the same token is `401`. Clients should also drop the\ntoken locally. This is the Slice-1 session end: JWTs stay stateless\napart from this denylist. There is no refresh token.\n",
        "responses": {
          "204": {
            "description": "Token revoked. The body is empty."
          },
          "400": {
            "description": "The token has no revocable id.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/target-region": {
      "get": {
        "tags": [
          "TargetRegion"
        ],
        "operationId": "getTargetRegion",
        "summary": "Read the signed-in user's target region",
        "description": "One region per user, the area where they want to open a new store.\n`404` when nothing has been saved yet.\n",
        "responses": {
          "200": {
            "description": "Saved target region.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TargetRegion"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "description": "This user has not saved a target region.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "TargetRegion"
        ],
        "operationId": "putTargetRegion",
        "summary": "Create or replace the target region",
        "description": "Upserts the single region for the token's user. Omitted geo fields are\nstored as null, including fields set by a previous save.\n",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TargetRegionWrite"
              },
              "example": {
                "label": "München",
                "grain": "ags",
                "geoKey": "09162000",
                "ags": "09162000",
                "lon": 11.5755,
                "lat": 48.1374
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Saved target region.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TargetRegion"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      },
      "delete": {
        "tags": [
          "TargetRegion"
        ],
        "operationId": "deleteTargetRegion",
        "summary": "Clear the target region",
        "description": "Idempotent. Responds `204` even when no region was stored.",
        "responses": {
          "204": {
            "description": "Target region cleared. The body is empty."
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/stores": {
      "get": {
        "tags": [
          "Stores"
        ],
        "operationId": "listStores",
        "summary": "List the signed-in user's store addresses",
        "responses": {
          "200": {
            "description": "Stores owned by the token's user, oldest first.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StoreList"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      },
      "post": {
        "tags": [
          "Stores"
        ],
        "operationId": "createStore",
        "summary": "Add a store address",
        "description": "German address (`postalCode` is PLZ5, `countryCode` is `DE`).\n`street` includes the house number.\n",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StoreLocationWrite"
              },
              "example": {
                "label": "Filiale Marienplatz",
                "street": "Marienplatz 1",
                "postalCode": "80331",
                "city": "München"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Store created.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StoreLocation"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/stores/{id}": {
      "parameters": [
        {
          "$ref": "#/components/parameters/StoreId"
        }
      ],
      "get": {
        "tags": [
          "Stores"
        ],
        "operationId": "getStore",
        "summary": "Read one store address",
        "description": "404 when the id is missing or belongs to another user.",
        "responses": {
          "200": {
            "description": "Store owned by the token's user.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StoreLocation"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "description": "No store with this id for the token's user.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "Stores"
        ],
        "operationId": "updateStore",
        "summary": "Replace a store address",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StoreLocationWrite"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated store.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StoreLocation"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "description": "No store with this id for the token's user.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "Stores"
        ],
        "operationId": "deleteStore",
        "summary": "Delete a store address",
        "description": "Also deletes monthly revenue for that store.",
        "responses": {
          "204": {
            "description": "Store deleted. The body is empty."
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "description": "No store with this id for the token's user.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/stores/{id}/revenue": {
      "parameters": [
        {
          "$ref": "#/components/parameters/StoreId"
        }
      ],
      "get": {
        "tags": [
          "Stores"
        ],
        "operationId": "listStoreRevenue",
        "summary": "Monthly revenue for one store",
        "description": "Points the customer has saved, ordered by year then month. A point with\n`revenueEur: null` was explicitly marked missing. A month with no point\nwas not entered. At most 36 points are stored per store.\n",
        "responses": {
          "200": {
            "description": "Saved months. Empty `points` when none have been entered.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MonthlyRevenueSeries"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "description": "No store with this id for the token's user.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "Stores"
        ],
        "operationId": "putStoreRevenue",
        "summary": "Upsert monthly revenue points",
        "description": "Inserts or replaces each `(year, month)` in the body. Other saved months\nstay. `revenueEur: null` marks that month as missing. The store can hold\nat most 36 months; a request that would exceed that returns `400` and\nchanges nothing.\n",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MonthlyRevenueWrite"
              },
              "example": {
                "points": [
                  {
                    "year": 2025,
                    "month": 1,
                    "revenueEur": 18450.5
                  },
                  {
                    "year": 2025,
                    "month": 2,
                    "revenueEur": null
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Full series after the upsert.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MonthlyRevenueSeries"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "description": "No store with this id for the token's user.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/stores/{id}/revenue/{year}/{month}": {
      "delete": {
        "tags": [
          "Stores"
        ],
        "operationId": "deleteStoreRevenueMonth",
        "summary": "Remove one monthly revenue point",
        "description": "`204` when the store exists, including when that month was not stored.\n`404` when the store is missing or belongs to another user.\n",
        "parameters": [
          {
            "$ref": "#/components/parameters/StoreId"
          },
          {
            "name": "year",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1990,
              "maximum": 2100
            }
          },
          {
            "name": "month",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 12
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Month removed, or it was not stored. The body is empty."
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "description": "No store with this id for the token's user.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/search": {
      "get": {
        "tags": [
          "Search"
        ],
        "operationId": "searchPlaces",
        "summary": "Search places by name, grain, or geo key",
        "description": "Reads `features.v_location_search` when that view contains at least one row.\nFilters apply to name, title, grain, and geo_key. `lon` and `lat` are\nJSON null when the row has no coordinates.\n\n`q` is a substring. `type` limits `q` to grain `ags`, `plz5`/`plz8`, or\n`address`. Without `type`, `q` matches name, title, and geo_key.\n`type` has no effect when `q` is omitted.\n\n`ags` and `plz` are exact geo_key matches on that grain. `geoKey` is an\nexact geo_key match on any grain. `grain` is exact. `address` is a\nsubstring of name, title, and geo_key. Filters combine with AND.\nAt most 50 hits, ordered by label.\n\nIf the view is missing or has no rows (local docker-compose), the same\nfilters run against the seeded `app.search_places` catalog.\nCoordinates are WGS84 (EPSG:4326) when present.\n",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "description": "Free-text substring. Interpretation depends on `type`.",
            "schema": {
              "type": "string",
              "maxLength": 200
            }
          },
          {
            "name": "type",
            "in": "query",
            "required": false,
            "description": "Field that `q` is matched against. Ignored when `q` is absent.",
            "schema": {
              "$ref": "#/components/schemas/SearchType"
            }
          },
          {
            "name": "address",
            "in": "query",
            "required": false,
            "description": "Substring matched against the address and the label.",
            "schema": {
              "type": "string",
              "maxLength": 300
            }
          },
          {
            "name": "ags",
            "in": "query",
            "required": false,
            "description": "Exact Amtlicher Gemeindeschlüssel (2–8 digits).",
            "schema": {
              "type": "string",
              "pattern": "^[0-9]{2,8}$"
            }
          },
          {
            "name": "plz",
            "in": "query",
            "required": false,
            "description": "Exact PLZ5 or PLZ8.",
            "schema": {
              "type": "string",
              "pattern": "^[0-9]{5}([0-9]{3})?$"
            }
          },
          {
            "name": "geoKey",
            "in": "query",
            "required": false,
            "description": "Exact geo_key on any grain.",
            "schema": {
              "type": "string",
              "maxLength": 200
            }
          },
          {
            "name": "grain",
            "in": "query",
            "required": false,
            "description": "Exact spatial grain.",
            "schema": {
              "$ref": "#/components/schemas/Grain"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Matching hits, at most 50, ordered by label.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchResponse"
                },
                "example": {
                  "hits": [
                    {
                      "id": "1",
                      "label": "München",
                      "grain": "ags",
                      "geoKey": "09162000",
                      "lon": null,
                      "lat": null
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/layers/{id}": {
      "get": {
        "tags": [
          "Layers"
        ],
        "operationId": "getLayer",
        "summary": "GeoJSON FeatureCollection for a layer",
        "description": "Returns a GeoJSON FeatureCollection as `application/json`.\nLayer rows stay in schema `app` (`map_layers`, `map_features`) until\nfeature documents have coordinates. Seeded layer ids in local dev:\n`demo-gemeinden`, `demo-plz`, `demo-grid100`.\nGeometries are synthetic stubs for this slice (points, plus one rough polygon),\nnot official boundaries. Coordinates are WGS84 (EPSG:4326), longitude then latitude.\n",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
            },
            "example": "demo-gemeinden"
          }
        ],
        "responses": {
          "200": {
            "description": "Layer contents. An existing layer with no features returns an empty `features` array.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FeatureCollection"
                },
                "example": {
                  "type": "FeatureCollection",
                  "name": "Demo-Gemeinden",
                  "description": "Synthetische Demo-Geometrien.",
                  "features": [
                    {
                      "type": "Feature",
                      "id": "ags:11000000",
                      "geometry": {
                        "type": "Point",
                        "coordinates": [
                          13.405,
                          52.52
                        ]
                      },
                      "properties": {
                        "label": "Berlin",
                        "grain": "ags",
                        "ags": "11000000",
                        "stub": true
                      }
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "description": "No layer with this id.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "parameters": {
      "StoreId": {
        "name": "id",
        "in": "path",
        "required": true,
        "description": "Store id as a decimal string.",
        "schema": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,18}$"
        }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Request failed validation.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "Unauthorized": {
        "description": "Missing or invalid bearer token.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      }
    },
    "schemas": {
      "HealthResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ]
          }
        }
      },
      "Credentials": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "email",
          "password"
        ],
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 320
          },
          "password": {
            "type": "string",
            "format": "password",
            "minLength": 8,
            "maxLength": 72
          }
        }
      },
      "TokenResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "accessToken",
          "tokenType",
          "expiresIn"
        ],
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "tokenType": {
            "type": "string",
            "enum": [
              "Bearer"
            ]
          },
          "expiresIn": {
            "type": "integer",
            "description": "Token lifetime in seconds.",
            "example": 28800
          }
        }
      },
      "User": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "email"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "User id as a decimal string."
          },
          "email": {
            "type": "string",
            "format": "email"
          }
        }
      },
      "Grain": {
        "type": "string",
        "description": "Spatial grain of a hit. Matches the Datenbasis grain list used by this slice.",
        "enum": [
          "address",
          "grid100",
          "plz8",
          "plz5",
          "ags",
          "ags5",
          "other"
        ]
      },
      "SearchType": {
        "type": "string",
        "enum": [
          "address",
          "ags",
          "plz"
        ]
      },
      "SearchHit": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "grain"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "grain": {
            "$ref": "#/components/schemas/Grain"
          },
          "geoKey": {
            "type": "string",
            "nullable": true,
            "description": "Spatial key from the feature view (AGS, PLZ, address id, or grid id). Null when unknown."
          },
          "lon": {
            "type": "number",
            "format": "double",
            "nullable": true,
            "description": "WGS84 longitude. Omitted or null when the hit is not geocoded."
          },
          "lat": {
            "type": "number",
            "format": "double",
            "nullable": true,
            "description": "WGS84 latitude. Omitted or null when the hit is not geocoded."
          }
        }
      },
      "SearchResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "hits"
        ],
        "properties": {
          "hits": {
            "type": "array",
            "maxItems": 50,
            "items": {
              "$ref": "#/components/schemas/SearchHit"
            }
          }
        }
      },
      "Geometry": {
        "type": "object",
        "required": [
          "type",
          "coordinates"
        ],
        "description": "GeoJSON geometry. This slice seeds Point and Polygon.",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "Point",
              "Polygon",
              "MultiPolygon"
            ]
          },
          "coordinates": {
            "description": "GeoJSON coordinates. Position order is longitude, latitude (EPSG:4326)."
          }
        },
        "additionalProperties": true
      },
      "Feature": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "geometry",
          "properties"
        ],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "Feature"
            ]
          },
          "id": {
            "type": "string"
          },
          "geometry": {
            "$ref": "#/components/schemas/Geometry"
          },
          "properties": {
            "type": "object",
            "additionalProperties": true,
            "description": "Includes label, grain, and stub: true for seeded demo features."
          }
        }
      },
      "FeatureCollection": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "features"
        ],
        "description": "GeoJSON FeatureCollection. `name` and `description` are foreign members\ncarried for this API (RFC 7946 allows them).\n",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "FeatureCollection"
            ]
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "features": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Feature"
            }
          }
        }
      },
      "TargetRegion": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "label",
          "updatedAt"
        ],
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "grain": {
            "type": "string",
            "nullable": true,
            "enum": [
              "address",
              "grid100",
              "plz8",
              "plz5",
              "ags",
              "ags5",
              "other"
            ],
            "description": "Same values as Grain. Null when the region is a free-text label."
          },
          "geoKey": {
            "type": "string",
            "nullable": true,
            "maxLength": 200
          },
          "ags": {
            "type": "string",
            "nullable": true,
            "pattern": "^[0-9]{2,8}$"
          },
          "plz": {
            "type": "string",
            "nullable": true,
            "pattern": "^[0-9]{5}([0-9]{3})?$"
          },
          "lon": {
            "type": "number",
            "format": "double",
            "nullable": true,
            "minimum": -180,
            "maximum": 180
          },
          "lat": {
            "type": "number",
            "format": "double",
            "nullable": true,
            "minimum": -90,
            "maximum": 90
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "TargetRegionWrite": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "label"
        ],
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "grain": {
            "type": "string",
            "nullable": true,
            "enum": [
              "address",
              "grid100",
              "plz8",
              "plz5",
              "ags",
              "ags5",
              "other"
            ]
          },
          "geoKey": {
            "type": "string",
            "nullable": true,
            "maxLength": 200
          },
          "ags": {
            "type": "string",
            "nullable": true,
            "pattern": "^[0-9]{2,8}$"
          },
          "plz": {
            "type": "string",
            "nullable": true,
            "pattern": "^[0-9]{5}([0-9]{3})?$"
          },
          "lon": {
            "type": "number",
            "format": "double",
            "nullable": true,
            "minimum": -180,
            "maximum": 180
          },
          "lat": {
            "type": "number",
            "format": "double",
            "nullable": true,
            "minimum": -90,
            "maximum": 90
          }
        }
      },
      "StoreLocation": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "street",
          "postalCode",
          "city",
          "countryCode",
          "createdAt",
          "updatedAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "Store id as a decimal string."
          },
          "label": {
            "type": "string",
            "nullable": true,
            "maxLength": 120,
            "description": "Optional store name."
          },
          "street": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "description": "Street and house number."
          },
          "postalCode": {
            "type": "string",
            "pattern": "^[0-9]{5}$",
            "description": "German PLZ5."
          },
          "city": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "countryCode": {
            "type": "string",
            "enum": [
              "DE"
            ]
          },
          "lon": {
            "type": "number",
            "format": "double",
            "nullable": true,
            "minimum": -180,
            "maximum": 180
          },
          "lat": {
            "type": "number",
            "format": "double",
            "nullable": true,
            "minimum": -90,
            "maximum": 90
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "StoreLocationWrite": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "street",
          "postalCode",
          "city"
        ],
        "properties": {
          "label": {
            "type": "string",
            "nullable": true,
            "maxLength": 120
          },
          "street": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "postalCode": {
            "type": "string",
            "pattern": "^[0-9]{5}$"
          },
          "city": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "countryCode": {
            "type": "string",
            "enum": [
              "DE"
            ],
            "default": "DE"
          },
          "lon": {
            "type": "number",
            "format": "double",
            "nullable": true,
            "minimum": -180,
            "maximum": 180
          },
          "lat": {
            "type": "number",
            "format": "double",
            "nullable": true,
            "minimum": -90,
            "maximum": 90
          }
        }
      },
      "StoreList": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "stores"
        ],
        "properties": {
          "stores": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/StoreLocation"
            }
          }
        }
      },
      "MonthlyRevenuePoint": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "year",
          "month",
          "revenueEur",
          "updatedAt"
        ],
        "properties": {
          "year": {
            "type": "integer",
            "minimum": 1990,
            "maximum": 2100
          },
          "month": {
            "type": "integer",
            "minimum": 1,
            "maximum": 12
          },
          "revenueEur": {
            "type": "number",
            "format": "double",
            "nullable": true,
            "minimum": 0,
            "description": "EUR. Null means the month was marked missing."
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "MonthlyRevenuePointWrite": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "year",
          "month",
          "revenueEur"
        ],
        "properties": {
          "year": {
            "type": "integer",
            "minimum": 1990,
            "maximum": 2100
          },
          "month": {
            "type": "integer",
            "minimum": 1,
            "maximum": 12
          },
          "revenueEur": {
            "type": "number",
            "format": "double",
            "nullable": true,
            "minimum": 0,
            "maximum": 9999999999.99
          }
        }
      },
      "MonthlyRevenueSeries": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "points"
        ],
        "properties": {
          "points": {
            "type": "array",
            "maxItems": 36,
            "items": {
              "$ref": "#/components/schemas/MonthlyRevenuePoint"
            }
          }
        }
      },
      "MonthlyRevenueWrite": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "points"
        ],
        "properties": {
          "points": {
            "type": "array",
            "minItems": 1,
            "maxItems": 36,
            "items": {
              "$ref": "#/components/schemas/MonthlyRevenuePointWrite"
            }
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "statusCode": {
            "type": "integer"
          },
          "message": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ]
          },
          "error": {
            "type": "string"
          }
        }
      }
    }
  }
}
